generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int             @id @default(autoincrement())
  email           String          @unique
  password        String
  name            String
  role            UserRole        @default(CUSTOMER)
  referralCode    String?         @unique
  points          Int             @default(0)
  pointsExpiry    DateTime?
  avatarUrl       String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organizedEvents Event[]
  passwordResets  PasswordReset[]
  referredBy      Referral?       @relation("UserReferredBy")
  referralsMade   Referral[]      @relation("Referrer")
  reviews         Review[]
  transactions    Transaction[]

  @@map("users")
}

model Referral {
  id             Int       @id @default(autoincrement())
  referrerId     Int
  referredUserId Int       @unique
  pointsAwarded  Int       @default(10000)
  couponCode     String?
  couponExpiry   DateTime?
  createdAt      DateTime  @default(now())
  referredUser   User      @relation("UserReferredBy", fields: [referredUserId], references: [id])
  referrer       User      @relation("Referrer", fields: [referrerId], references: [id])

  @@map("referrals")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model Event {
  id             Int           @id @default(autoincrement())
  name           String
  description    String
  price          Int
  startDate      DateTime
  endDate        DateTime
  availableSeats Int
  location       String
  category       String
  imageUrl       String?
  isPublished    Boolean       @default(false)
  organizerId    Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  coupons        Coupon[]
  organizer      User          @relation(fields: [organizerId], references: [id])
  reviews        Review[]
  transactions   Transaction[]
  vouchers       Voucher[]

  @@map("events")
}

model Voucher {
  id             Int           @id @default(autoincrement())
  code           String
  discountAmount Int
  startDate      DateTime
  endDate        DateTime
  maxUsage       Int
  usedCount      Int           @default(0)
  eventId        Int
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([code, eventId])
  @@map("vouchers")
}

model Transaction {
  id            Int               @id @default(autoincrement())
  userId        Int
  eventId       Int
  quantity      Int
  totalPrice    Int
  originalPrice Int
  pointsUsed    Int               @default(0)
  voucherId     Int?
  couponId      Int?
  status        TransactionStatus @default(WAITING_PAYMENT)
  paymentProof  String?
  expiredAt     DateTime
  confirmedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  coupon        Coupon?           @relation(fields: [couponId], references: [id])
  event         Event             @relation(fields: [eventId], references: [id])
  user          User              @relation(fields: [userId], references: [id])
  voucher       Voucher?          @relation(fields: [voucherId], references: [id])

  @@map("transactions")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
  @@map("reviews")
}

model Coupon {
  id             Int           @id @default(autoincrement())
  code           String        @unique
  userId         Int
  discountAmount Int           @default(10000)
  expiryDate     DateTime
  isUsed         Boolean       @default(false)
  usedAt         DateTime?
  eventId        Int?
  createdAt      DateTime      @default(now())
  event          Event?        @relation(fields: [eventId], references: [id])
  transactions   Transaction[]

  @@map("coupons")
}

enum UserRole {
  CUSTOMER
  ORGANIZER
}

enum TransactionStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
}
