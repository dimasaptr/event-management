// ============================================
// MODEL UNTUK FEATURE 2 (Auth & User)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  name          String
  role          UserRole  @default(CUSTOMER)
  referralCode  String?   @unique
  points        Int       @default(0)
  pointsExpiry  DateTime?
  avatarUrl     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizedEvents   Event[]
  transactions      Transaction[]
  reviews           Review[]
  referredBy        Referral? @relation("UserReferredBy")
  referralsMade     Referral[] @relation("Referrer")
  passwordResets    PasswordReset[]

  @@map("users")
}

enum UserRole {
  CUSTOMER
  ORGANIZER
}

model Referral {
  id              Int       @id @default(autoincrement())
  referrerId      Int
  referrer        User      @relation("Referrer", fields: [referrerId], references: [id])
  referredUserId  Int       @unique
  referredUser    User      @relation("UserReferredBy", fields: [referredUserId], references: [id])
  pointsAwarded   Int       @default(10000)
  couponCode      String?
  couponExpiry    DateTime?
  createdAt       DateTime  @default(now())

  @@map("referrals")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@map("password_resets")
}

// ============================================
// MODEL UNTUK FEATURE 1 (Events)
// ============================================

model Event {
  id              Int       @id @default(autoincrement())
  name            String
  description     String    @db.Text
  price           Int
  startDate       DateTime
  endDate         DateTime
  availableSeats  Int
  location        String
  category        String
  imageUrl        String?
  isPublished     Boolean   @default(false)
  organizerId     Int
  organizer       User      @relation(fields: [organizerId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vouchers      Voucher[]
  transactions  Transaction[]
  reviews       Review[]
  coupons       Coupon[]

  @@map("events")
}

model Voucher {
  id             Int       @id @default(autoincrement())
  code           String
  discountAmount Int
  startDate      DateTime
  endDate        DateTime
  maxUsage       Int
  usedCount      Int       @default(0)
  eventId        Int
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  transactions   Transaction[]

  @@unique([code, eventId])
  @@map("vouchers")
}

// ============================================
// MODEL UNTUK FEATURE 1 (Transactions)
// ============================================

model Transaction {
  id              Int               @id @default(autoincrement())
  userId          Int
  user            User              @relation(fields: [userId], references: [id])
  eventId         Int
  event           Event             @relation(fields: [eventId], references: [id])
  quantity        Int
  totalPrice      Int
  originalPrice   Int
  pointsUsed      Int               @default(0)
  voucherId       Int?
  voucher         Voucher?          @relation(fields: [voucherId], references: [id])
  couponId        Int?
  coupon          Coupon?           @relation(fields: [couponId], references: [id])
  status          TransactionStatus @default(WAITING_PAYMENT)
  paymentProof    String?
  expiredAt       DateTime
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("transactions")
}

enum TransactionStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

// ============================================
// MODEL UNTUK FEATURE 1 (Reviews)
// ============================================

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@map("reviews")
}

// ============================================
// MODEL UNTUK FEATURE 2 (Coupons)
// ============================================

model Coupon {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  userId      Int
  discountAmount Int    @default(10000)
  expiryDate  DateTime
  isUsed      Boolean   @default(false)
  usedAt      DateTime?
  eventId     Int?
  event       Event?    @relation(fields: [eventId], references: [id])
  createdAt   DateTime  @default(now())

  transactions Transaction[]

  @@map("coupons")
}