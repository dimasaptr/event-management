// =========================================
// FILE INFO
// =========================================
// File Name   : schema.prisma
// Type        : Prisma Schema
// Feature     : Event Management Platform
// Route       : -
// Source Path : apps/api/prisma/schema.prisma
// Used In     : Backend Database Schema
// UI Section  : Database Core
// Status      : ACTIVE
// Notes       : Event Management MVP Database Design
// =========================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==================
// ENUMS
// ==================

enum UserRole {
  CUSTOMER
  ORGANIZER
}

enum EventCategory {
  WORKSHOP
  SEMINAR
  BOOTCAMP
  WEBINAR
  COURSE
  NETWORKING
  COMPETITION
  OTHER
}

enum EventLocationType {
  ONLINE
  OFFLINE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELED
}

enum TransactionStatus {
  WAITING_FOR_PAYMENT
  WAITING_FOR_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

enum PaymentMethod {
  MANUAL_TRANSFER
  VIRTUAL_ACCOUNT
  E_WALLET
}

enum PaymentProofStatus {
  NOT_UPLOADED
  UPLOADED
  VERIFIED
  REJECTED
}

// ==================
// MODELS
// ==================

model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  password              String
  firstName             String
  lastName              String
  role                  UserRole    @default(CUSTOMER)
  profilePicture        String?
  
  // Referral System
  referralCode          String      @unique @default(cuid())
  referredBy            String?     // ID of user who referred this user
  pointsBalance         Int         @default(0)
  
  // Relations
  organizedEvents       Event[]     @relation("OrganizerEvents")
  transactions          Transaction[] @relation("CustomerTransactions")
  reviews               Review[]
  referralsCoupon       ReferralCoupon[]
  pointsHistory         PointsHistory[]
  
  // Email verification
  emailVerified         Boolean     @default(false)
  verificationToken     String?
  verificationTokenExp  DateTime?
  
  // Password reset
  resetToken            String?
  resetTokenExp         DateTime?
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model Event {
  id                    String      @id @default(cuid())
  slug                  String      @unique
  title                 String
  description           String      @db.Text
  shortDescription      String
  
  category              EventCategory
  
  price                 Float       @default(0) // In IDR
  isFree                Boolean     @default(true)
  isFeatured            Boolean     @default(false)
  
  thumbnail             String?
  bannerUrl             String?
  
  totalSeats            Int
  availableSeats        Int
  registeredCount       Int         @default(0)
  
  startDate             DateTime
  endDate               DateTime
  
  locationType          EventLocationType
  city                  String?
  province              String?
  country               String?
  address               String?
  meetingUrl            String?
  platform              String?
  
  status                EventStatus @default(DRAFT)
  
  organizerId           String
  organizer             User        @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  
  // Relations
  transactions          Transaction[]
  reviews               Review[]
  vouchers              Voucher[]
  
  averageRating         Float?
  totalReviews          Int         @default(0)
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  @@index([organizerId])
  @@index([category])
  @@index([status])
}

model Transaction {
  id                    String      @id @default(cuid())
  
  customerId            String
  customer              User        @relation("CustomerTransactions", fields: [customerId], references: [id], onDelete: Cascade)
  
  eventId               String
  event                 Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  quantity              Int
  basePrice             Float       // Original price before discount (In IDR)
  finalPrice            Float       // Final price after all discounts (In IDR)
  
  status                TransactionStatus @default(WAITING_FOR_PAYMENT)
  paymentMethod         PaymentMethod?
  
  // Discounts
  voucherUsed           String?     // Voucher ID
  voucher               Voucher?    @relation(fields: [voucherUsed], references: [id])
  voucherDiscount       Float       @default(0) // In IDR
  
  couponUsed            String?     // Referral coupon ID
  coupon                ReferralCoupon? @relation(fields: [couponUsed], references: [id])
  couponDiscount        Float       @default(0) // In IDR
  
  pointsUsed            Int         @default(0)
  pointsDiscountAmount  Float       @default(0) // In IDR (assuming 1 point = 100 IDR or based on config)
  
  // Payment Proof
  paymentProofStatus    PaymentProofStatus @default(NOT_UPLOADED)
  paymentProofUrl       String?
  uploadedAt            DateTime?
  verifiedAt            DateTime?
  
  // Automatic expiry
  paymentDeadline       DateTime?   // 2 hours from creation
  adminDeadline         DateTime?   // 3 days from payment proof upload
  
  rejectionReason       String?
  notes                 String?     @db.Text
  
  // Relations
  tickets               Ticket[]
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  @@index([customerId])
  @@index([eventId])
  @@index([status])
}

model Ticket {
  id                    String      @id @default(cuid())
  
  transactionId         String
  transaction           Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  ticketNumber          String      @unique
  code                  String      @unique // QR code or barcode
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  @@index([transactionId])
}

model Voucher {
  id                    String      @id @default(cuid())
  code                  String      @unique
  
  eventId               String
  event                 Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  discountValue         Float       // In IDR
  discountType          String      // FIXED or PERCENTAGE
  
  isActive              Boolean     @default(true)
  maxUses               Int?        // Null = unlimited
  currentUses           Int         @default(0)
  
  startDate             DateTime
  endDate               DateTime
  
  // Relations
  usedInTransactions    Transaction[]
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  @@index([eventId])
}

model ReferralCoupon {
  id                    String      @id @default(cuid())
  
  referrerId            String      // User who got referred
  referrer              User        @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  
  discountValue         Float       // System discount value (In IDR)
  discountPercentage    Float       @default(10) // Default 10%
  
  isUsed                Boolean     @default(false)
  usedAt                DateTime?
  
  expiresAt             DateTime    // 3 months from referral
  
  // Relations
  usedInTransactions    Transaction[]
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  @@index([referrerId])
}

model PointsHistory {
  id                    String      @id @default(cuid())
  
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type                  String      // EARNED, USED, EXPIRED, REFUNDED
  amount                Int
  description           String
  relatedTransactionId  String?
  
  expiresAt             DateTime?   // 3 months from earning
  
  createdAt             DateTime    @default(now())
  
  @@index([userId])
}

model Review {
  id                    String      @id @default(cuid())
  
  eventId               String
  event                 Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating                Int         // 1-5
  comment               String?     @db.Text
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  @@unique([eventId, userId]) // One review per user per event
  @@index([eventId])
  @@index([userId])
}